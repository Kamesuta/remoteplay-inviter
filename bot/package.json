{
  "name": "remoteplay-inviter-bot",
  "version": "1.0.0",
  "description": "Invite your friends via Discord and play Steam games together for free!",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "tsx scripts/register.ts",
    "mock": "tsx scripts/mock-client.ts",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "author": "Kamesuta",
  "license": "MIT",
  "dependencies": {
    "discord-api-types": "^0.38.56",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.12",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "~4.1.12",
    "wrangler": "^4.151.1"
  }
}
